# Get AGE private key from password store for SOPS decryption
export SOPS_AGE_KEY=$(pass show talos-key)

# Decrypt env.yaml and export variables directly into the shell session
if [ -f "env.yaml" ]; then
  eval "$(sops -d --output-type dotenv env.yaml | sed 's/^/export /')"
fi

# Define paths for decrypted configuration files in volatile memory (tmpfs)
export TALOSCONFIG="/run/user/$(id -u)/talosconfig-$(basename $PWD)"
export KUBECONFIG="/run/user/$(id -u)/hetzner-kubeconfig-$(basename $PWD)"
export PATCH_CP="/run/user/$(id -u)/controlplane-patch-$(basename $PWD).yaml"
export PATCH_WK="/run/user/$(id -u)/worker-patch-$(basename $PWD).yaml"

# Decrypt Talos client configuration to tmpfs if not already present
if [ ! -f "$TALOSCONFIG" ]; then
    sops -d talosconfig > "$TALOSCONFIG"
    chmod 600 "$TALOSCONFIG"
fi

# Generate/extract Kubeconfig from Talos if not already present
if [ ! -f "$KUBECONFIG" ]; then
    talosctl kubeconfig "$KUBECONFIG" -n $CONTROL_PLANE_IP
    chmod 600 "$KUBECONFIG"
fi

# Decrypt patches to tmpfs
if [ ! -f "$PATCH_CP" ]; then
    sops -d patches/controlplane.yaml > "$PATCH_CP"
    chmod 600 "$PATCH_CP"
fi
if [ ! -f "$PATCH_WK" ]; then
    sops -d patches/worker.yaml > "$PATCH_WK"
    chmod 600 "$PATCH_WK"
fi
